<% content_for :title, "Crear cuenta" %>

<div class="card narrow">
  <h1>Crear cuenta</h1>
  <p class="muted">Solo te lleva un minuto.</p>

  <%= form_with model: @client, url: signup_path, class: "form" do |f| %>
    <%= error_messages_for(@client) %>
    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name, required: true, autofocus: true, autocomplete: "name" %>
    </div>
    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email, required: true, autocomplete: "email" %>
    </div>
    <div class="field">
      <%= f.label :phone %>
      <%= f.telephone_field :phone, autocomplete: "tel" %>
      <span class="hint">Opcional, por si necesitamos avisarte algo.</span>
    </div>
    <div class="form-row">
      <div class="field">
        <%= f.label :password %>
        <%= f.password_field :password, required: true, autocomplete: "new-password" %>
      </div>
      <div class="field">
        <%= f.label :password_confirmation, "Repetir contraseña" %>
        <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
      </div>
    </div>
    <%= f.submit "Crear cuenta", class: "btn block" %>
  <% end %>

  <p class="muted" style="margin:16px 0 0; text-align:center">
    ¿Ya tenés cuenta? <%= link_to "Ingresá", login_path %>
  </p>
</div>
