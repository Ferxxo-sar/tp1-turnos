<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= [ content_for(:title), "Admin", business_name ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= render "shared/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <% if current_admin %>
      <div class="admin-shell">
        <aside class="sidebar">
          <%= link_to admin_root_path, class: "brand" do %>
            <span class="brand-name"><%= business_name %></span>
            <span class="brand-sub">Back-office</span>
          <% end %>

          <nav aria-label="Back-office">
            <span class="nav-group">Operación</span>
            <%= nav_link "Inicio", admin_root_path, exact: true, icon: :home %>
            <%= nav_link "Agenda", admin_agenda_path, icon: :calendar %>
            <%= nav_link "Turnos", admin_appointments_path, icon: :list %>
            <%= nav_link "Clientes", admin_clients_path, icon: :users %>

            <span class="nav-group">Catálogo</span>
            <%= nav_link "Profesionales", admin_stylists_path, icon: :scissors %>
            <%= nav_link "Servicios", admin_services_path, icon: :tag %>
            <%= nav_link "Categorías", admin_categories_path, icon: :folder %>

            <span class="nav-group">Gestión</span>
            <%= nav_link "Reportes", admin_reports_path, icon: :chart %>
            <%= nav_link "Administradores", admin_admin_users_path, icon: :shield %>
            <%= nav_link "Base de datos", madmin_root_path, icon: :folder %>
          </nav>

          <div class="me">
            <div>
              <strong><%= current_admin.name %></strong>
              <span class="muted small"><%= current_admin.email %></span>
            </div>
            <div class="button-row">
              <%= link_to root_path, class: "btn sm secondary", title: "Ver sitio público" do %>
                <%= icon(:external, size: 15) %> Sitio
              <% end %>
              <%= button_to admin_logout_path, method: :delete, class: "sm secondary", title: "Cerrar sesión" do %>
                <%= icon(:logout, size: 15) %> Salir
              <% end %>
            </div>
          </div>
        </aside>
        <main class="admin-main">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main class="auth-page">
        <div class="auth-box">
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </main>
    <% end %>
  </body>
</html>
