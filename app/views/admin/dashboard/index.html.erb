<% content_for :title, "Inicio" %>

<div class="page-head">
  <div>
    <h1>Hola, <%= current_admin.name.split.first %> 👋</h1>
    <p class="muted" style="margin:0"><%= l(Date.current, format: :long).capitalize %></p>
  </div>
  <div class="actions">
    <%= link_to "+ Nuevo turno", new_admin_appointment_path, class: "btn" %>
  </div>
</div>

<div class="grid grid-4">
  <div class="card stat"><span class="label">Turnos hoy</span><span class="value"><%= @stats[:today] %></span></div>
  <div class="card stat"><span class="label">Pendientes de confirmar</span><span class="value"><%= @stats[:pending] %></span></div>
  <div class="card stat"><span class="label">Turnos esta semana</span><span class="value"><%= @stats[:week] %></span></div>
  <div class="card stat"><span class="label">Facturado en el mes</span><span class="value"><%= money(@month_revenue) %></span></div>
</div>

<div class="section">
  <div class="section-head">
    <h2>Agenda de hoy</h2>
    <%= link_to "Ver todos", admin_appointments_path(date: Date.current.iso8601) %>
  </div>
  <%= render "admin/appointments/table", appointments: @today, empty_message: "No hay turnos para hoy." %>
</div>

<div class="section">
  <div class="section-head">
    <h2>Pendientes de confirmar</h2>
    <%= link_to "Ver todos", admin_appointments_path(status: "pending") %>
  </div>
  <%= render "admin/appointments/table", appointments: @pending, empty_message: "No hay turnos pendientes. 🎉" %>
</div>
