<%= form_with model: admin_user, url: admin_user.persisted? ? admin_admin_user_path(admin_user) : admin_admin_users_path, class: "form card" do |f| %>
  <%= error_messages_for(admin_user) %>

  <div class="form-row">
    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name, required: true %>
    </div>
    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email, required: true, autocomplete: "off" %>
    </div>
  </div>

  <div class="form-row">
    <div class="field">
      <%= f.label :password, admin_user.new_record? ? "Contraseña" : "Nueva contraseña" %>
      <%= f.password_field :password, required: admin_user.new_record?, minlength: 8, autocomplete: "new-password" %>
      <span class="hint"><%= admin_user.new_record? ? "Mínimo 8 caracteres." : "Dejala vacía para conservar la actual." %></span>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "Repetir contraseña" %>
      <%= f.password_field :password_confirmation, required: admin_user.new_record?, autocomplete: "new-password" %>
    </div>
  </div>

  <div class="form-actions">
    <%= link_to "Cancelar", admin_admin_users_path, class: "btn secondary" %>
    <%= f.submit "Guardar", class: "btn" %>
  </div>
<% end %>
