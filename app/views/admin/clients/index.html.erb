<% content_for :title, "Clientes" %>

<div class="page-head"><h1>Clientes</h1></div>

<%= form_with url: admin_clients_path, method: :get, class: "filters" do |f| %>
  <div class="field">
    <%= f.label :q, "Buscar" %>
    <%= f.search_field :q, value: params[:q], placeholder: "Nombre o email" %>
  </div>
  <%= f.submit "Buscar", name: nil, class: "btn secondary" %>
<% end %>

<div class="card flush">
  <% if @clients.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Nombre</th><th>Email</th><th>Teléfono</th><th>Alta</th></tr></thead>
        <tbody>
          <% @clients.each do |client| %>
            <tr>
              <td><%= link_to client.name, admin_client_path(client) %></td>
              <td><%= client.email %></td>
              <td><%= client.phone.presence || "—" %></td>
              <td class="muted"><%= l(client.created_at.to_date) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty">No se encontraron clientes.</div>
  <% end %>
</div>
