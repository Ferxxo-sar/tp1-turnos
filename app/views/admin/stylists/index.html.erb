<% content_for :title, "Profesionales" %>

<div class="page-head">
  <div>
    <span class="eyebrow">Catálogo</span>
    <h1>Profesionales</h1>
  </div>
  <div class="actions">
    <%= link_to new_admin_stylist_path, class: "btn" do %>
      <%= icon(:plus, size: 16) %> Nuevo profesional
    <% end %>
  </div>
</div>

<% if @stylists.any? %>
  <div class="grid grid-3">
    <% @stylists.each do |stylist| %>
      <article class="card person-card">
        <div class="person">
          <%= avatar_for(stylist) %>
          <div>
            <h3 style="margin:0"><%= link_to stylist.name, admin_stylist_path(stylist) %></h3>
            <span class="muted small"><%= stylist.specialty %></span>
          </div>
        </div>
        <p class="small muted"><%= pluralize(@upcoming_counts.fetch(stylist.id, 0), "turno próximo", plural: "turnos próximos") %></p>
        <div class="actions button-row">
          <%= link_to "Agenda", admin_agenda_path(stylist_id: stylist.id), class: "btn sm secondary" %>
          <%= link_to "Ficha", admin_stylist_path(stylist), class: "btn sm secondary" %>
          <%= link_to "Editar", edit_admin_stylist_path(stylist), class: "btn sm secondary" %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="card empty">Todavía no hay profesionales. <%= link_to "Cargar el primero", new_admin_stylist_path %>.</div>
<% end %>
